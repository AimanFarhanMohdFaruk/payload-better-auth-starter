description: Standard server/client data access — DAL, API routes, lib/api, TanStack Query hooks, thin UI.
globs: src/components/**/*.tsx,src/hooks/**/*.ts,src/hooks/**/*.tsx,src/app/api/**/*.ts,src/lib/dal/**/*.ts,src/lib/api/**/*.ts
alwaysApply: false
